{
  "name": "mewo",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Charles Wang",
    "email": "hi@charleszw.com",
    "url": "https://charleszw.com"
  },
  "type": "module",
  "main": "src/main/index.ts",
  "scripts": {
    "build:preload": "bun build src/preload/index.ts --outfile dist/preload.cjs --target node --format cjs --external electron",
    "build:renderer": "bun build src/renderer/index.html --outdir dist --sourcemap=linked",
    "build:css": "tailwindcss -i src/renderer/styles/main.css -o src/renderer/styles/generated/tailwind.css",
    "watch:preload": "bun run build:preload --watch --check",
    "watch:renderer": "bun run build:renderer --watch --check",
    "watch:css": "bun run build:css --watch=always",
    "app": "electron .",
    "build": "rm -rf dist && bun run build:preload --minify --production && bun run build:css --minify && bun run build:renderer --minify --production",
    "start": "bun run build && bun run app",
    "dev": "rm -rf dist && bun run build:css && bun run --parallel watch:preload watch:renderer watch:css app"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/css-modules": "^1.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
